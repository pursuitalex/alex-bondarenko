# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
# The same variables must also be added in the Vercel project settings,
# otherwise the deployed form answers 503.

# Required. Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where briefs land. Defaults to the address in src/lib/brand.ts.
# BRIEF_TO=pursuit.alex@gmail.com

# Optional. Sender. The default (onboarding@resend.dev) is Resend's shared
# address and only delivers to the account owner — fine while briefs go to your
# own inbox. Once a domain is verified in Resend, switch to it, e.g.
# BRIEF_FROM=Заявка з сайту <brief@yourdomain.com>
