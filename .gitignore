# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which carries names only — never values
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working source comps — huge PSD/PNG, must never be published
# (leading "!" escaped: in gitignore an unescaped "!" means negation)
/\!!!-do-not-deploy/

# Source originals (PNG/PSD/video/SVG) — local-only working files, never
# pushed. `npm run images` re-encodes them into /public, and /public is what
# the site actually serves. Editable copy lives in src/content/, NOT here, so
# that this whole folder can stay out of git without breaking the build.
/assets/
