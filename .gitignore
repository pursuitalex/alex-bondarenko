# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working source comps — huge PSD/PNG, must never be published
# (leading "!" escaped: in gitignore an unescaped "!" means negation)
/\!!!-do-not-deploy/

# Image/video ORIGINALS — kept locally only, never pushed. `npm run images`
# re-encodes them into /public (WebP), and /public is what the site serves.
# The .ts files under assets/ are NOT ignored: src/ imports them, so dropping
# them from git would break the production build.
/assets/**/*.png
/assets/**/*.jpg
/assets/**/*.jpeg
/assets/**/*.psd
/assets/video/
